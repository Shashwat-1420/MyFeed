# SavedFeed Environment Variables
# Expo inlines EXPO_PUBLIC_* at build time. Supabase is OPTIONAL — the app runs
# fully offline with the on-device AI path + keyword fallback in src/lib/aiAdapter.ts.
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
